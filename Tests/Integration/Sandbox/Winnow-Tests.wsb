<Configuration>
  <!--
    Windows Sandbox configuration for the mutating integration tests.

    The repository is mapped read-only so a test cannot modify the working tree
    it was launched from. A second folder is mapped writable so the results
    survive: everything else inside the sandbox is destroyed when the window
    closes, including the console output.

    Both HostFolder paths must already exist or the sandbox refuses to start.
    Update them if the repository does not live at this path, then open this
    file to start the run.
  -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\Antigravity_Projects\Winnow</HostFolder>
      <SandboxFolder>C:\Winnow</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\Antigravity_Projects\Winnow\Tests\Integration\Sandbox\results</HostFolder>
      <SandboxFolder>C:\Winnow-Results</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Winnow\Tests\Integration\Sandbox\Start-SandboxRun.ps1</Command>
  </LogonCommand>
  <MemoryInMB>4096</MemoryInMB>
  <Networking>Enable</Networking>
</Configuration>
